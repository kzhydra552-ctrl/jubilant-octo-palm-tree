PORT=3000
# Segredo obrigatório para o seu script chamar a API
API_KEY=troque-por-um-segredo-longo-e-aleatorio
# Login privado do painel /dashboard
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=troque-por-outra-senha-forte
# Cole aqui a URL do webhook do Discord; nunca publique este arquivo
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/SEU_ID/SEU_TOKEN
# Limite padrão: 10 milhões
THRESHOLD=10000000
# Em Railway, use um Volume montado em /app/data para persistir dados
DATA_FILE=/app/data/logs.json

# Bridge WebSocket contínuo
WS_URL=wss://seu-endpoint-websocket
SECRET_KEY=chave-da-websocket
WEBHOOK_MID=https://discord.com/api/webhooks/...
WEBHOOK_HIGH=https://discord.com/api/webhooks/...
WEBHOOK_ULTRA=https://discord.com/api/webhooks/...
WEBHOOK_JOBID=https://discord.com/api/webhooks/...
IMAGE_API=https://stealabrainrot.fandom.com/api.php
